# 12. BOOTSTRAPPING
# ============================================================

print("\n========== BOOTSTRAPPING ==========")

bootstrap_medians = []

for i in range(1000):

    sample_data = df["Revenue"].sample(
        len(df),
        replace=True
    )

    bootstrap_medians.append(
        sample_data.median()
    )

lower = np.percentile(
    bootstrap_medians,
    2.5
)

upper = np.percentile(
    bootstrap_medians,
    97.5
)

print("Bootstrap Median:", np.median(bootstrap_medians))
print("95% Bootstrap CI:", lower, upper)

plt.figure(figsize=(8, 5))
