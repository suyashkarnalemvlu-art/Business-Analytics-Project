# ============================================================
# 11. CONFIDENCE INTERVAL
# ============================================================

print("\n========== CONFIDENCE INTERVAL ==========")

revenue = df["Revenue"]

mean_revenue = revenue.mean()
std_revenue = revenue.std()
n = len(revenue)

for confidence in [0.90, 0.95, 0.99]:

    z = stats.norm.ppf(
        1 - (1 - confidence) / 2
    )

    margin = z * std_revenue / np.sqrt(n)

    lower = mean_revenue - margin
    upper = mean_revenue + margin

    print(
        f"{int(confidence * 100)}% Confidence Interval:"
    )

    print(
        "Lower:",
        lower,
        "Upper:",
        upper
    )


