# 19. SIMULATION MODELING
# ============================================================

print("\n========== SIMULATION ==========")

np.random.seed(42)

scenarios = {}

for scenario in ["Low Demand", "Medium Demand", "High Demand"]:

    if scenario == "Low Demand":
        demand = np.random.normal(100, 15, 1000)

    elif scenario == "Medium Demand":
        demand = np.random.normal(150, 20, 1000)

    else:
        demand = np.random.normal(200, 25, 1000)

    demand = np.maximum(demand, 0)

    sales = demand * 20

    scenarios[scenario] = sales.mean()

print("Average Sales by Scenario:")

for scenario, sales in scenarios.items():
    print(scenario, ":", sales)


plt.figure(figsize=(8, 5))
plt.bar(
    list(scenarios.keys()),
    list(scenarios.values())
)

plt.title("Simulation Scenario Comparison")
plt.xlabel("Scenario")
plt.ylabel("Average Sales")
plt.show()


