# ============================================================

print("\n========== OPTIMIZATION ==========")

from scipy.optimize import linprog

# Example:
# Product A profit = 40
# Product B profit = 30

profit = [-40, -30]

# Resource constraints
A = [
    [2, 1],
    [1, 2]
]

b = [
    100,
    80
]

result = linprog(
    profit,
    A_ub=A,
    b_ub=b,
    bounds=[(0, None), (0, None)],
    method="highs"
)

print("Optimal Product A:", result.x[0])
print("Optimal Product B:", result.x[1])
print("Maximum Profit:", -result.fun)


