# 14. A/B TESTING
# ============================================================

print("\n========== A/B TESTING ==========")

# Split transactions into two groups
group_A = df.iloc[:len(df)//2]["Revenue"]
group_B = df.iloc[len(df)//2:]["Revenue"]

t_stat, p_value = stats.ttest_ind(
    group_A,
    group_B,
    equal_var=False
)

print("Group A Mean:", group_A.mean())
print("Group B Mean:", group_B.mean())
print("T-statistic:", t_stat)
print("P-value:", p_value)


